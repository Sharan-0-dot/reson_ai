# ResonAI Backend Environment Variables

# LLM Provider Options: 'gemini' (direct Google API) or 'openrouter'
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# OpenRouter Configuration (when using LLM_PROVIDER=openrouter or keys starting with sk-or-)
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=google/gemini-2.5-flash

LLM_TIMEOUT_S=25
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
